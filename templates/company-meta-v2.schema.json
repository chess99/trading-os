{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-os.local/schemas/company-meta-v2.schema.json",
  "title": "Trading OS Company Research Metadata v2",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "research",
    "reports",
    "underwriting",
    "valuation",
    "triggers",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "identity": {
      "type": "object",
      "required": ["symbol", "market", "ticker", "name", "currency", "security_status"],
      "properties": {
        "symbol": {"type": "string", "pattern": "^(CN|HK|US):[A-Z0-9.]+$"},
        "market": {"type": "string", "enum": ["CN", "HK", "US"]},
        "ticker": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 1},
        "security_status": {"type": "string", "enum": ["active", "inactive", "archived"]}
      },
      "additionalProperties": false
    },
    "research": {
      "type": "object",
      "required": ["coverage_status", "rebaseline_required", "information_cutoff"],
      "properties": {
        "coverage_status": {"type": "string", "enum": ["covered", "researching", "requires_rebaseline", "inactive"]},
        "rebaseline_required": {"type": "boolean"},
        "information_cutoff": {"type": ["string", "null"], "format": "date-time"},
        "refresh_due_at": {"type": ["string", "null"], "format": "date-time"},
        "latest_rapid_triage": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/latest_rapid_triage"}
          ]
        }
      },
      "additionalProperties": false
    },
    "reports": {
      "type": "object",
      "required": ["latest", "latest_by_type", "history", "historical_artifacts"],
      "properties": {
        "latest": {"type": ["string", "null"]},
        "latest_by_type": {
          "type": "object",
          "propertyNames": {"enum": ["rapid_triage", "initial_research", "monitoring_update", "underwriting_review", "challenger_review"]},
          "additionalProperties": {"type": "string", "pattern": "^reports/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*\\.md$"}
        },
        "history": {
          "type": "array",
          "items": {"$ref": "#/$defs/report_record"}
        },
        "historical_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/historical_artifact"}
        }
      },
      "additionalProperties": false
    },
    "underwriting": {
      "type": "object",
      "required": ["status", "review_id", "confidence", "evidence_valid_until", "reason_codes"],
      "properties": {
        "status": {"type": ["string", "null"], "enum": [null, "passed", "failed", "insufficient_evidence", "needs_challenger", "stale"]},
        "review_id": {"type": ["string", "null"]},
        "confidence": {"type": ["string", "null"], "enum": [null, "high", "medium", "low"]},
        "evidence_valid_until": {"type": ["string", "null"], "format": "date-time"},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "valuation": {
      "type": "object",
      "required": ["currency", "price_as_of", "bear_value", "fair_value_range", "buy_zone", "reduce_zone"],
      "properties": {
        "currency": {"type": ["string", "null"]},
        "price_as_of": {"type": ["string", "null"], "format": "date-time"},
        "bear_value": {"type": ["number", "null"]},
        "fair_value_range": {"$ref": "#/$defs/nullable_range"},
        "buy_zone": {"$ref": "#/$defs/nullable_range"},
        "reduce_zone": {"$ref": "#/$defs/nullable_range"}
      },
      "additionalProperties": false
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger_id", "type", "condition", "reason", "active"],
        "properties": {
          "trigger_id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["date", "price", "filing", "event", "thesis"]},
          "condition": {"type": "object"},
          "reason": {"type": "string", "minLength": 1},
          "active": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "report_type": {"type": "string", "enum": ["rapid_triage", "initial_research", "monitoring_update", "underwriting_review", "challenger_review"]},
    "latest_rapid_triage": {
      "type": "object",
      "required": ["report_id", "report_path", "source_package_path", "source_package_sha256", "information_cutoff", "review_mode", "published_at"],
      "properties": {
        "report_id": {"type": "string", "minLength": 1},
        "report_path": {"type": "string", "pattern": "^reports/[0-9]{4}-[0-9]{2}-[0-9]{2}-rapid-triage-[a-f0-9]{12}\\.md$"},
        "source_package_path": {"type": "string", "minLength": 1},
        "source_package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "information_cutoff": {"type": "string", "format": "date-time"},
        "review_mode": {"type": "string", "enum": ["baseline_recheck", "triggered_update"]},
        "published_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "report_record": {
      "type": "object",
      "required": ["report_id", "path", "report_type", "as_of", "sha256"],
      "properties": {
        "report_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^reports/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*\\.md$"},
        "report_type": {"$ref": "#/$defs/report_type"},
        "as_of": {"type": "string", "format": "date"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "historical_artifact": {
      "type": "object",
      "required": ["path", "format", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"type": "string", "const": "legacy_v1"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "nullable_range": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false, "minItems": 2, "maxItems": 2}
      ]
    }
  },
  "additionalProperties": false
}
