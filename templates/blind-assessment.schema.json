{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-os.local/schemas/blind-assessment.schema.json",
  "title": "Trading OS Sealed Blind Assessment",
  "type": "object",
  "required": ["schema_version", "assessment_id", "review_id", "packet_sha256", "symbol", "information_cutoff", "price_snapshot", "evidence_ledger", "earnings_bridge", "cash_flow_bridge", "safety_margin_tier", "valuation", "counterevidence", "provisional_status", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "assessment_id": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "symbol": {"type": "string", "pattern": "^(CN|HK|US):[A-Z0-9.]+$"},
    "information_cutoff": {"type": "string", "format": "date-time"},
    "price_snapshot": {"type": "object"},
    "evidence_ledger": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "earnings_bridge": {"type": "object"},
    "cash_flow_bridge": {"type": "object"},
    "safety_margin_tier": {"type": "string", "enum": ["standard", "elevated", "severe"]},
    "valuation": {
      "type": "object",
      "required": ["bear", "base", "bull", "methods", "fair_value_range", "buy_zone", "required_return"],
      "properties": {
        "bear": {"type": "number"},
        "base": {"type": "number"},
        "bull": {"type": "number"},
        "methods": {"type": "array", "minItems": 2, "items": {"type": "object"}},
        "fair_value_range": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false, "minItems": 2, "maxItems": 2},
        "buy_zone": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false, "minItems": 2, "maxItems": 2},
        "required_return": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "counterevidence": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "provisional_status": {"type": "string", "enum": ["passed", "failed", "insufficient_evidence", "needs_challenger", "stale"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
