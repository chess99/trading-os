{
  "schema_version": 2,
  "policy_id": "manager-screening.default",
  "version": "1.2.0",
  "effective_at": "2026-07-31T16:55:00+08:00",
  "kind": "manager_screening",
  "payload": {
    "default_batch_size": 150,
    "minimum_batch_size": 50,
    "maximum_batch_size": 250,
    "fact_snapshot_required": true,
    "minimum_annual_periods": 3,
    "routes": [
      "pass",
      "watch",
      "send_to_analyst"
    ],
    "quick_profile_effort_budget_hours": 1.5,
    "send_to_analyst_capacity_per_run": 200,
    "run_control_required": true,
    "decision_contract_version": 2,
    "mandatory_risk_acknowledgement": true,
    "canonical_fact_line_required": true,
    "high_liability_to_assets_pct": 90.0,
    "quote_amendment_review_absolute_price_change_pct": 20.0,
    "quick_profile_stop_conditions": [
      "业务、股东现金路径或关键会计桥接仍不可理解",
      "生存、治理、资本结构或证据可靠性构成明确阻断",
      "正常化所有者收益不足以支撑继续研究",
      "当前价格已充分资本化可验证的改善",
      "决定性问题在预算内不可解决且没有高价值补证路径"
    ],
    "pass_and_watch_require_revisit_trigger": true,
    "one_line_reason_max_chars": 240,
    "decisive_question_max_chars": 600,
    "quality": {
      "programmatic_validation_rate": 1.0,
      "material_error_types": [
        "security_identity_error",
        "verifiable_factual_error",
        "material_risk_omission",
        "decision_contract_violation"
      ],
      "route_disagreement_is_material_error": false,
      "calibration_sample_rate": 0.05,
      "calibration_minimum_per_batch": 3,
      "adjudication_limit_per_company": 1
    },
    "recursive_correction": "forbidden",
    "principles": {
      "same_manager_per_batch": true,
      "single_company_agent_for_screening": false,
      "administrative_order_only": true,
      "machine_ranking_may_exclude_companies": false,
      "manager_route_allocates_analyst_budget": true,
      "underwriting_begins_after_deep_research": true
    }
  }
}
