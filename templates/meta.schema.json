{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trading OS Company Research Metadata",
  "type": "object",
  "required": [
    "symbol",
    "market",
    "ticker",
    "name",
    "currency",
    "status",
    "current_rating",
    "current_thesis",
    "fair_value_range",
    "buy_zone",
    "sell_or_reduce_zone",
    "position_plan",
    "latest_report",
    "report_history",
    "review_triggers",
    "price_triggers",
    "updated_at"
  ],
  "properties": {
    "symbol": {"type": "string", "minLength": 1, "pattern": "^(CN|HK|US):[A-Z0-9.]+$"},
    "market": {"type": "string", "minLength": 1, "enum": ["CN", "HK", "US"]},
    "ticker": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1, "enum": ["active", "inactive", "archived"]},
    "current_rating": {
      "type": "string",
      "minLength": 1,
      "enum": ["buy", "watch", "hold", "avoid", "sell", "research_only"]
    },
    "current_thesis": {"type": "string", "minLength": 1},
    "fair_value_range": {
      "description": "Two-item numeric range; lower bound must be <= upper bound, enforced by validate_company_dir.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "buy_zone": {
      "description": "Two-item numeric range; lower bound must be <= upper bound, enforced by validate_company_dir.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "sell_or_reduce_zone": {
      "description": "Two-item numeric range; lower bound must be <= upper bound, enforced by validate_company_dir.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "position_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["condition", "max_weight"],
        "properties": {
          "condition": {"type": "string", "minLength": 1},
          "max_weight": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "latest_report": {
      "type": "string",
      "minLength": 1,
      "pattern": "^reports/\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]*\\.md$"
    },
    "report_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^reports/\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]*\\.md$"
      }
    },
    "review_triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "date", "reason"],
        "properties": {
          "type": {"type": "string", "minLength": 1, "enum": ["date"]},
          "date": {"type": "string", "minLength": 1, "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "price_triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "price", "reason"],
        "properties": {
          "type": {"type": "string", "minLength": 1, "enum": ["price_below", "price_above"]},
          "price": {"type": "number"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "updated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
