{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-os.local/schemas/review-run.schema.json",
  "title": "Trading OS Underwriting Review Run",
  "type": "object",
  "required": ["schema_version", "run_id", "scope", "status", "created_at", "policy_versions", "candidate_set", "parent_run_id"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "scope": {
      "type": "object",
      "required": ["type", "market", "description"],
      "properties": {
        "type": {"type": "string", "enum": ["industry", "theme", "full_market", "custom"]},
        "market": {"type": "string", "enum": ["CN", "HK", "US", "MULTI"]},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "status": {"type": "string", "enum": ["created", "candidates_frozen", "packets_ready", "blind_reviewing", "blind_sealed", "revealing", "challenging", "company_reviews_complete", "synthesizing", "completed", "blocked_missing_evidence", "failed_agent", "failed_validation", "stale_quotes", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "policy_versions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "candidate_set": {
      "type": "object",
      "required": ["frozen", "frozen_at", "sha256", "count"],
      "properties": {
        "frozen": {"type": "boolean"},
        "frozen_at": {"type": ["string", "null"], "format": "date-time"},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "parent_run_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
