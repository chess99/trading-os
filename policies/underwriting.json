{
  "schema_version": 2,
  "policy_id": "underwriting.default",
  "version": "1.2.0",
  "effective_at": "2026-07-23T00:00:00+08:00",
  "kind": "underwriting",
  "payload": {
    "default_holding_period_years": [1, 3],
    "portfolio_entry_return_hurdle_reference": 0.12,
    "minimum_valuation_discount_rate": 0.085,
    "government_bond_spread": 0.055,
    "valuation_principle": "intrinsic_value_uses_risk_adjusted_equity_cost; target_return_is_tested_at_portfolio_entry",
    "safety_margin_application": "apply_once_to_intrinsic_value; do_not_discount_a_hurdle_rate_dcf_again",
    "minimum_safety_margin": {
      "high_confidence": 0.10,
      "medium_confidence": 0.15,
      "low_confidence": null
    },
    "risk_overlay_safety_margin": {
      "elevated": 0.20,
      "severe": 0.25
    },
    "evidence_gap_principle": "unresolved evidence changes underwriting status and cannot be cured by a lower price",
    "risk_counting_principle": "the same risk must not be charged repeatedly through discount rate, scenario haircut and safety margin without explicit justification",
    "minimum_counterevidence_items": 3,
    "minimum_valuation_methods": 2,
    "required_scenarios": ["bear", "base", "bull"],
    "critical_financial_source_tier": "S1",
    "freshness_days": {
      "cyclical_price_and_inventory": 30,
      "general_industry_operating_data": 90
    },
    "challenger_thresholds": {
      "old_new_fair_value_midpoint_difference": 0.30,
      "valuation_method_difference": 0.40
    }
  }
