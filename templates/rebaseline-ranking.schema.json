{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-os.local/schemas/rebaseline-ranking.schema.json",
  "title": "Trading OS Rebaseline Research Priority Ranking",
  "type": "object",
  "required": ["schema_version", "algorithm_version", "generated_at", "retriage_completed", "inputs", "snapshot", "ranked_count", "excluded_count", "items", "excluded"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "algorithm_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "retriage_completed": {"type": "boolean"},
    "inputs": {"type": "object"},
    "snapshot": {"type": "object"},
    "ranked_count": {"type": "integer", "minimum": 0},
    "excluded_count": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "symbol", "name", "industry", "economic_risk_cluster", "total_score", "score_confidence", "dimensions", "penalties", "reason_codes", "missing_fields", "public_snapshot", "magic_formula", "target_company_dir"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "symbol": {"type": "string", "pattern": "^CN:[0-9]{6}$"},
          "name": {"type": "string", "minLength": 1},
          "industry": {"type": "string", "minLength": 1},
          "economic_risk_cluster": {"type": "string", "minLength": 1},
          "total_score": {"type": "number", "minimum": 0, "maximum": 100},
          "score_confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "dimensions": {"type": "object"},
          "penalties": {"type": "array"},
          "reason_codes": {"type": "array", "items": {"type": "string"}},
          "missing_fields": {"type": "array", "items": {"type": "string"}},
          "public_snapshot": {"type": "object"},
          "magic_formula": {"type": ["object", "null"]},
          "target_company_dir": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "excluded": {"type": "array"}
  },
  "additionalProperties": false
}
