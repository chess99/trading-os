{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-os.local/schemas/research-allocation.schema.json",
  "title": "Trading OS Research Capacity Allocation",
  "type": "object",
  "required": [
    "schema_version",
    "ranking_generated_at",
    "ranking_content_sha256",
    "policy_version",
    "policy_payload_sha256",
    "principle",
    "capacity",
    "effort_budget_hours",
    "confidence_counts",
    "warnings",
    "lens_counts",
    "risk_cluster_counts",
    "selected_count",
    "deferred_count",
    "selected",
    "deferred",
    "excluded"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "ranking_generated_at": {"type": "string", "format": "date-time"},
    "ranking_content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version": {"type": "string", "minLength": 1},
    "policy_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "principle": {"type": "string", "minLength": 1},
    "capacity": {"type": "object"},
    "effort_budget_hours": {"type": "object"},
    "confidence_counts": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "lens_counts": {"type": "object"},
    "risk_cluster_counts": {"type": "object"},
    "selected_count": {"type": "integer", "minimum": 0},
    "deferred_count": {"type": "integer", "minimum": 0},
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "stage",
          "effort_budget_hours",
          "selected_by",
          "matched_lenses",
          "economic_risk_cluster",
          "ranking_confidence",
          "reason_codes"
        ],
        "properties": {
          "symbol": {"type": "string", "pattern": "^CN:[0-9]{6}$"},
          "name": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "const": "rapid_triage"},
          "effort_budget_hours": {"type": "number", "exclusiveMinimum": 0},
          "selected_by": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "matched_lenses": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "economic_risk_cluster": {"type": "string", "minLength": 1},
          "ranking_confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "stage",
          "reason_code",
          "reactivation_trigger_types"
        ],
        "properties": {
          "symbol": {"type": "string", "pattern": "^CN:[0-9]{6}$"},
          "name": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "const": "catalog"},
          "reason_code": {"type": "string", "minLength": 1},
          "reactivation_trigger_types": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "excluded": {"type": "array"}
  },
  "additionalProperties": false
}
