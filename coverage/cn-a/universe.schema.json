{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CN A-share Universe Snapshot",
  "type": "object",
  "required": ["schema_version", "market", "as_of", "source", "securities"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "market": {"type": "string", "const": "CN"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source": {"type": "string", "minLength": 1},
    "securities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "ticker",
          "name",
          "exchange",
          "security_type",
          "listing_status"
        ],
        "properties": {
          "symbol": {"type": "string", "pattern": "^CN:[0-9]{6}$"},
          "ticker": {"type": "string", "pattern": "^[0-9]{6}$"},
          "name": {"type": "string", "minLength": 1},
          "exchange": {"type": "string", "enum": ["SSE", "SZSE", "BSE"]},
          "security_type": {"type": "string", "minLength": 1},
          "listing_status": {"type": "string", "minLength": 1},
          "market_cap_cny": {"type": ["number", "null"]},
          "avg_daily_turnover_cny": {"type": ["number", "null"]},
          "tags": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
