{
  "schema_version": 2,
  "policy_id": "research-allocation.default",
  "version": "3.0.0",
  "effective_at": "2026-07-28T00:00:00+08:00",
  "kind": "research_allocation",
  "payload": {
    "candidate_pool_capacity_per_cycle": 200,
    "quick_profile_capacity_per_cycle": 40,
    "stage_capacity_per_cycle": {
      "scoped_research": 15,
      "deep_research": 6,
      "underwriting": 3
    },
    "effort_budget_hours": {
      "rapid_triage": 0.25,
      "quick_profile": 1.0,
      "targeted_followup": 2.0,
      "scoped_research": 4.0,
      "deep_research": 24.0,
      "underwriting": 12.0
    },
    "selection_slots": {
      "balanced": 30,
      "value_income": 20,
      "quality_compounder": 20,
      "magic_formula_nonfinancial": 30,
      "financial_specialist": 20,
      "cyclical_specialist": 20,
      "crisis_mispricing": 30,
      "information_change": 20,
      "false_negative_audit": 10
    },
    "risk_cluster_caps": {
      "rapid_triage": 25,
      "quick_profile": 10,
      "scoped_research": 5,
      "deep_research": 2,
      "underwriting": 1
    },
    "industry_evidence_requirements": {
      "credit_cycle": {
        "quick_profile": [
          "bank_latest_s1_filing",
          "bank_asset_quality_migration",
          "bank_capital_adequacy"
        ],
        "scoped_research": [
          "bank_latest_s1_filing",
          "bank_asset_quality_migration",
          "bank_normalized_credit_cost_and_nim",
          "bank_common_equity_earnings_after_capital_instruments",
          "bank_capital_adequacy",
          "bank_property_lgf_exposure"
        ]
      }
    },
    "minimum_s1_sources_for_deep_research": 2,
    "minimum_counterevidence_for_quick_profile": 2,
    "minimum_base_expected_annual_return_for_deep_research": 0.10,
    "minimum_base_expected_annual_return_for_underwriting": 0.12,
    "structural_stop_reason_codes": [
      "minority_shareholder_claim_unreliable",
      "financial_statements_unreliable_without_alternative_verification",
      "cannot_survive_24_months_without_forced_dilution",
      "capital_structure_precludes_equity_value",
      "core_economics_persistently_below_cost_of_capital_without_remedy",
      "core_thesis_disproven"
    ],
    "reactivation_trigger_types": [
      "filing",
      "price",
      "event",
      "thesis"
    ],
    "ranking_principle": "public screening scores are a cheap map for selecting a dynamic rapid-triage candidate pool and must never directly promote a company to a formal profile, deep research, underwriting or buy_now",
    "research_value_principle": "allocate the next research hour where it is most likely to change a portfolio decision; uncertainty that is expensive or unresolvable lowers priority",
    "stop_principle": "a stop is an auditable research-capital decision, not a permanent investment verdict; every non-structural stop requires a reactivation trigger",
    "comparison_principle": "formal-profile capacity is allocated only after the complete rapid-triage cohort is sealed and compared cross-sectionally; completion order must not affect promotion"
  }
}
