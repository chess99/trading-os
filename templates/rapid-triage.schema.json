{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-os.local/schemas/rapid-triage.schema.json",
  "title": "Trading OS Rapid Triage Package",
  "type": "object",
  "required": [
    "schema_version",
    "cycle_id",
    "symbol",
    "company_name",
    "as_of",
    "information_cutoff",
    "price_as_of",
    "price_source_id",
    "current_price",
    "review_mode",
    "prior_research_path",
    "trigger_context",
    "business_summary",
    "change_summary",
    "normalized_earnings_view",
    "expectations_view",
    "counterevidence",
    "business_legibility",
    "survival_status",
    "governance_status",
    "earnings_legibility",
    "valuation_signal",
    "research_value",
    "decisive_question",
    "reason_codes",
    "revisit_triggers",
    "sources",
    "provenance"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "cycle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "symbol": {"type": "string", "pattern": "^CN:[0-9]{6}$"},
    "company_name": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "information_cutoff": {"type": "string", "format": "date-time"},
    "price_as_of": {"type": "string", "format": "date-time"},
    "price_source_id": {"type": "string", "minLength": 1},
    "current_price": {"type": "number", "exclusiveMinimum": 0},
    "review_mode": {
      "type": "string",
      "enum": ["baseline_recheck", "triggered_update"]
    },
    "prior_research_path": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "trigger_context": {"type": "string", "minLength": 1},
    "business_summary": {"type": "string", "minLength": 1},
    "change_summary": {"type": "string", "minLength": 1},
    "normalized_earnings_view": {"type": "string", "minLength": 1},
    "expectations_view": {"type": "string", "minLength": 1},
    "counterevidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "business_legibility": {
      "type": "string",
      "enum": ["clear", "uncertain", "opaque"]
    },
    "survival_status": {
      "type": "string",
      "enum": ["pass", "concern", "fail"]
    },
    "governance_status": {
      "type": "string",
      "enum": ["acceptable", "concern", "uninvestable"]
    },
    "earnings_legibility": {
      "type": "string",
      "enum": ["plausible", "uncertain", "unavailable"]
    },
    "valuation_signal": {
      "type": "string",
      "enum": ["attractive", "possible", "unattractive", "unknown"]
    },
    "research_value": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "decisive_question": {"type": "string", "minLength": 1},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "revisit_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/trigger"}
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/source"}
    },
    "provenance": {
      "type": "object",
      "required": ["agent", "model", "tools", "generated_at"],
      "properties": {
        "agent": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "generated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "required": ["trigger_id", "type", "condition", "reason"],
          "properties": {
            "trigger_id": {"type": "string", "minLength": 1},
            "type": {"const": "price"},
            "condition": {
              "type": "object",
              "required": ["operator", "threshold"],
              "properties": {
                "operator": {"enum": ["price_lte", "price_gte"]},
                "threshold": {"type": "number", "exclusiveMinimum": 0}
              },
              "additionalProperties": false
            },
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["trigger_id", "type", "condition", "reason"],
          "properties": {
            "trigger_id": {"type": "string", "minLength": 1},
            "type": {"const": "date"},
            "condition": {
              "type": "object",
              "required": ["date"],
              "properties": {"date": {"type": "string", "format": "date"}},
              "additionalProperties": false
            },
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["trigger_id", "type", "condition", "reason"],
          "properties": {
            "trigger_id": {"type": "string", "minLength": 1},
            "type": {"const": "ttl"},
            "condition": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["days"],
                  "properties": {"days": {"type": "integer", "minimum": 1}},
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["due_at"],
                  "properties": {
                    "due_at": {"type": "string", "format": "date-time"}
                  },
                  "additionalProperties": false
                }
              ]
            },
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["trigger_id", "type", "condition", "reason"],
          "properties": {
            "trigger_id": {"type": "string", "minLength": 1},
            "type": {"enum": ["filing", "event", "thesis"]},
            "condition": {
              "type": "object",
              "required": ["description"],
              "properties": {"description": {"type": "string", "minLength": 1}},
              "additionalProperties": false
            },
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "tier",
        "title",
        "accessed_at",
        "url",
        "local_path",
        "supports"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "tier": {"type": "string", "enum": ["S1", "S2", "S3"]},
        "title": {"type": "string", "minLength": 1},
        "accessed_at": {"type": "string", "format": "date-time"},
        "url": {"type": ["string", "null"]},
        "local_path": {"type": ["string", "null"]},
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "anyOf": [
        {"properties": {"url": {"type": "string", "minLength": 1}}},
        {"properties": {"local_path": {"type": "string", "minLength": 1}}}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
