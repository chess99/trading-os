{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-os.local/schemas/portfolio.schema.json",
  "title": "Trading OS Model Portfolio Decision v3",
  "type": "object",
  "required": [
    "schema_version",
    "portfolio_id",
    "run_id",
    "as_of",
    "quote_snapshot_sha256",
    "policy_snapshot_sha256",
    "policy_versions",
    "positions",
    "cash_weight",
    "exclusions"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "portfolio_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "quote_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_versions": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "positions": {
      "type": "array",
      "items": {"$ref": "#/$defs/position"}
    },
    "cash_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "action", "reason_codes"],
        "properties": {
          "symbol": {"type": "string", "pattern": "^(CN|HK|US):[A-Z0-9.]+$"},
          "action": {
            "type": "string",
            "enum": ["buy_on_weakness", "hold", "reduce", "exit", "watch", "reject"]
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "returnModel": {
      "type": "object",
      "required": [
        "schema_version",
        "method",
        "currency",
        "model_as_of",
        "base_case_distributions_per_share",
        "base_case_terminal_value_per_share"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "method": {"type": "string", "const": "annual_cashflow_irr_v1"},
        "currency": {"type": "string", "minLength": 1},
        "model_as_of": {"type": "string", "format": "date-time"},
        "base_case_distributions_per_share": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {"type": "number", "minimum": 0}
        },
        "base_case_terminal_value_per_share": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "required": [
        "symbol",
        "name",
        "underwriting_status",
        "evidence_stale",
        "confidence",
        "action",
        "current_price",
        "price_as_of",
        "expected_annual_return",
        "minimum_expected_annual_return",
        "expected_return_gap",
        "minimum_return_activation_price",
        "near_miss_return_activation_price",
        "buy_now_price_ceiling",
        "bear_value",
        "fair_value_range",
        "buy_zone",
        "reduce_zone",
        "return_model",
        "portfolio_candidate_sha256",
        "target_weight",
        "initial_entry_weight",
        "industry",
        "economic_risk_clusters",
        "reason_codes"
      ],
      "properties": {
        "symbol": {"type": "string", "pattern": "^(CN|HK|US):[A-Z0-9.]+$"},
        "name": {"type": "string", "minLength": 1},
        "underwriting_status": {
          "type": "string",
          "enum": ["passed", "failed", "insufficient_evidence", "needs_challenger", "stale"]
        },
        "evidence_stale": {"type": "boolean"},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "action": {
          "type": "string",
          "enum": ["buy_now", "buy_on_weakness", "hold", "reduce", "exit", "watch", "reject"]
        },
        "current_price": {"type": "number", "exclusiveMinimum": 0},
        "price_as_of": {"type": "string", "format": "date-time"},
        "expected_annual_return": {"type": "number"},
        "minimum_expected_annual_return": {"type": "number"},
        "expected_return_gap": {"type": "number"},
        "minimum_return_activation_price": {"type": "number", "exclusiveMinimum": 0},
        "near_miss_return_activation_price": {"type": "number", "exclusiveMinimum": 0},
        "buy_now_price_ceiling": {"type": "number", "exclusiveMinimum": 0},
        "bear_value": {"type": "number"},
        "fair_value_range": {"$ref": "#/$defs/range"},
        "buy_zone": {"$ref": "#/$defs/range"},
        "reduce_zone": {"$ref": "#/$defs/range"},
        "return_model": {"$ref": "#/$defs/returnModel"},
        "portfolio_candidate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "initial_entry_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "industry": {"type": "string", "minLength": 1},
        "economic_risk_clusters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
