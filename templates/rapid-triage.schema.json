{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-os.local/schemas/rapid-triage.schema.json",
  "title": "Trading OS Rapid Triage Package",
  "type": "object",
  "required": [
    "schema_version",
    "cycle_id",
    "symbol",
    "company_name",
    "as_of",
    "information_cutoff",
    "price_as_of",
    "price_source_id",
    "current_price",
    "business_legibility",
    "survival_status",
    "governance_status",
    "earnings_legibility",
    "valuation_signal",
    "research_value",
    "decisive_question",
    "reason_codes",
    "revisit_triggers",
    "sources",
    "provenance"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "cycle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "symbol": {"type": "string", "pattern": "^CN:[0-9]{6}$"},
    "company_name": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "information_cutoff": {"type": "string", "format": "date-time"},
    "price_as_of": {"type": "string", "format": "date-time"},
    "price_source_id": {"type": "string", "minLength": 1},
    "current_price": {"type": "number", "exclusiveMinimum": 0},
    "business_legibility": {
      "type": "string",
      "enum": ["clear", "uncertain", "opaque"]
    },
    "survival_status": {
      "type": "string",
      "enum": ["pass", "concern", "fail"]
    },
    "governance_status": {
      "type": "string",
      "enum": ["acceptable", "concern", "uninvestable"]
    },
    "earnings_legibility": {
      "type": "string",
      "enum": ["plausible", "uncertain", "unavailable"]
    },
    "valuation_signal": {
      "type": "string",
      "enum": ["attractive", "possible", "unattractive", "unknown"]
    },
    "research_value": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "decisive_question": {"type": ["string", "null"], "minLength": 1},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "revisit_triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "condition", "reason"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["filing", "price", "event", "thesis"]
          },
          "condition": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/source"}
    },
    "provenance": {
      "type": "object",
      "required": ["agent", "model", "tools", "generated_at"],
      "properties": {
        "agent": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "generated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "tier",
        "title",
        "accessed_at",
        "url",
        "local_path",
        "supports"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "tier": {"type": "string", "enum": ["S1", "S2", "S3"]},
        "title": {"type": "string", "minLength": 1},
        "accessed_at": {"type": "string", "format": "date-time"},
        "url": {"type": ["string", "null"]},
        "local_path": {"type": ["string", "null"]},
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "anyOf": [
        {"properties": {"url": {"type": "string", "minLength": 1}}},
        {"properties": {"local_path": {"type": "string", "minLength": 1}}}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
